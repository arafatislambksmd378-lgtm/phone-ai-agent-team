# ============================================================
# Phone AI Agent Team — Configuration (.env)
# Copy this file to .env and chmod 600 .env
# Never commit .env to Git!
# ============================================================

# --- Telegram (required for bot daemon mode; omit for `python3 main.py --demo`) ---
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (send /start to @userinfobot). Only this user is authorized.
TELEGRAM_ALLOWED_USER_ID=

# --- AI Providers (configure at least ONE for live AI code generation; empty = deterministic MOCK fallback) ---
GEMINI_API_KEY=
AI_MODEL_DEFAULT=gemini-2.0-flash
AI_MODEL_GEMINI=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_OPENAI=gpt-4o-mini

# Optional OpenAI Codex / dedicated coding endpoint
CODEX_API_KEY=
CODEX_BASE_URL=https://api.openai.com/v1
AI_MODEL_CODEX=gpt-4o

ANTHROPIC_API_KEY=
AI_MODEL_ANTHROPIC=claude-3-5-haiku-latest

# Provider priority order & resilience
AI_PROVIDER_ORDER=gemini,openai,anthropic
ALLOW_PROVIDER_FALLBACK=true
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4096

# --- Shared Android Dashboard REST API (FAIL-CLOSED AUTHENTICATION) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Required (>= 24 chars, high entropy). Server refuses to start without it.
API_AUTH_TOKEN=
# Bind 127.0.0.1 behind an HTTPS reverse proxy (Caddy/nginx/Cloudflare Tunnel).
API_HOST=127.0.0.1
API_PORT=8000
# Set true to run the Android REST API alongside Telegram in the same process/DB.
ENABLE_API_SERVER=false
# Optional native TLS termination (otherwise terminate HTTPS at reverse proxy):
API_TLS_CERT=
API_TLS_KEY=
# Required if binding the optional Web Setup Portal (--web) to a non-loopback address:
WEB_SETUP_TOKEN=

# --- GitHub & Optional External Build Integration ---
GITHUB_TOKEN=
GITHUB_REMOTE_REPO=
EXTERNAL_BUILD_URL=

# --- Android 14 / Termux 3 GB RAM Resource Limits ---
# Default is 1 worker. Setting 2 enables a second worker ONLY when free RAM >= MIN_FREE_RAM_MB_WORKER2.
MAX_CONCURRENT_WORKERS=1
MIN_FREE_RAM_MB_WORKER2=600
MIN_FREE_DISK_MB=250
TASK_TIMEOUT_SECONDS=600
STALE_TASK_SECONDS=900
# Failed tasks retry with exponential backoff: delay = min(BASE^(n-1), MAX) seconds.
RETRY_BACKOFF_BASE_SECONDS=2
RETRY_BACKOFF_MAX_SECONDS=300

# --- Security, Upload & Approval Controls ---
MAX_UPLOAD_MB=20
MAX_ZIP_MB=50
MAX_ZIP_FILES=500
APPROVAL_TTL_SECONDS=3600
# Require human Telegram approval once live AI spend on a project reaches this USD threshold (0 = disabled)
PAID_COST_APPROVAL_USD=5.0

# --- Storage & Logging ---
WORKSPACE_ROOT=./projects
DB_PATH=./data/phone_agent.db
LOG_LEVEL=INFO
LOG_FILE=./logs/agent.log

# --- Project Memory Retention ---
# Number of versions kept per (project, kind, key); older superseded entries are pruned.
MEMORY_VERSIONS_PER_KEY=25
