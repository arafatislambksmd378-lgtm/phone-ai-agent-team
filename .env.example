# Phone AI Agent Team — configuration template.
# Copy to .env (never commit .env):  cp .env.example .env && chmod 600 .env

# ---------- Telegram (required for the bot interface) ----------
# Get a token from @BotFather, and your numeric id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# ---------- AI provider (at least one; Gemini has a free tier) ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI or any OpenAI-compatible gateway (LM Studio, OpenRouter, Azure...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---------- Routing ----------
# Order in which providers are tried, comma separated.
AI_PROVIDER_ORDER=gemini,openai,anthropic
# Try the next provider when one fails. Set false to pin the first provider.
ALLOW_PROVIDER_FALLBACK=true
# Per-provider model names (change freely; nothing is hardcoded).
AI_MODEL_GEMINI=gemini-2.0-flash
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_ANTHROPIC=claude-3-5-haiku-latest
AI_MODEL_DEFAULT=gemini-2.0-flash
# Per-agent override, e.g. MODEL_CODE_REVIEWER=gemini-2.5-pro
# MODEL_<AGENT_ID_UPPER>=<model>

# ---------- Runtime (tuned for a 3 GB phone) ----------
MAX_CONCURRENT_WORKERS=1
TASK_TIMEOUT_SECONDS=600
AI_TIMEOUT_SECONDS=60
WORKSPACE_ROOT=./projects
DB_PATH=./data/phone_agent.db
LOG_LEVEL=INFO
LOG_FILE=./logs/agent.log

# ---------- Upload limits ----------
MAX_UPLOAD_MB=20
MAX_ZIP_MB=50
MAX_ZIP_FILES=500
